{
  "expo": {
    "name": "Планер",
    "slug": "RN-Training",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoT.png",
    "scheme": "rntraining",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.developer747.rntraining",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/LogoT.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/LogoT.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "943a7a8d-f23a-4db2-b2db-7298af073a5c"
      }
    },
    "owner": "developer747"
  }
}
